{
  "name": "apnaestore-backend",
  "version": "1.0.0",
  "description": "ApnaEstore Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:auth": "jest test/auth.test.js --verbose",
    "test:stores": "jest test/stores.test.js --verbose",
    "test:webhooks": "jest test/webhooks.test.js --verbose",
    "test:payment": "jest test/paymentGateway.test.js --verbose",
    "test:products": "jest test/products.test.js --verbose"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@google/generative-ai": "^0.24.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cron": "^4.4.0",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.6",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "uuid": "^9.0.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "testTimeout": 15000,
    "verbose": true,
    "maxWorkers": 1
  },
  "allowScripts": {
    "sharp@0.33.5": true
  }
}
